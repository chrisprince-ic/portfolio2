# Gemini API key for the "Talk to My Clone" chatbot (server-side only, never committed).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-2.5-pro).
# gemini-2.5-flash replies faster and costs less.
# GEMINI_MODEL=gemini-2.5-flash
