# Gemini API key for the "Talk to My Clone" chatbot (server-side only, never committed).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-flash-latest).
# For smarter but slower replies: gemini-3.1-pro-preview
# GEMINI_MODEL=gemini-3.1-pro-preview
